# Terraform state and plans (never commit state or generated plans)
*.tfstate
*.tfstate.*
*.tfplan
crash.log
crash.*.log

# Local Terraform working directory (keep .terraform.lock.hcl tracked)
.terraform/

# Local variable files may contain environment-specific or sensitive values
*.tfvars
*.tfvars.json

# Terraform overrides and CLI configuration
override.tf
override.tf.json
*_override.tf
*_override.tf.json
.terraformrc
terraform.rc

# IDE, editor, OS and temporary files
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store
*.iml
Thumbs.db
Desktop.ini
*.log
*.bak
*.backup
.cache/
